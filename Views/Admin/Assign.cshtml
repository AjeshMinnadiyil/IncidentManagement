
@model IncidentManagement.ViewModels.AssignTechnicianViewModel

@{
    ViewData["Title"] = "Assign Technician";
}

<h2>Assign Technician</h2>

<form asp-action="Assign" method="post">
    @Html.AntiForgeryToken()

    <input asp-for="TicketId" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="TechnicianId" class="form-label">
            Select Technician
        </label>

        <select asp-for="TechnicianId"
                asp-items="ViewBag.Technicians"
                class="form-select">
            <option value="">-- Select Technician --</option>
        </select>

        <span asp-validation-for="TechnicianId"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Assign Ticket
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
