@model IncidentManagement.Models.Ticket

@{
    ViewData["Title"] = "Ticket Details";
}

<h2>Ticket Details</h2>

<div class="card mb-4">
    <div class="card-body">
        <h4>@Model.Title</h4>

        <p>
            <strong>Request Number:</strong>
            @Model.RequestNumber
        </p>

        <p>
            <strong>Request Type:</strong>
            @Model.Category?.RequestType
        </p>

        <p>
            <strong>Category:</strong>
            @Model.Category?.Name
        </p>

        <p>
            <strong>Description:</strong>
            @Model.Description
        </p>

        <p>
            <strong>Status:</strong>
            <span class="badge bg-primary">@Model.Status</span>
        </p>

        <p>
            <strong>Created At:</strong>
            @Model.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
        </p>
    </div>
</div>


<h4 class="mt-4">Ticket Status History</h4>

@if (Model.Updates.Any())
{
    <div class="list-group mb-4">
        @foreach (var update in Model.Updates)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between
                    align-items-center mb-2">
                    <strong>
                        @(update.Status ?? "Update")
                    </strong>

                    <small class="text-muted">
                        @update.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                        
                        
                    </small>
                </div>

                <p class="mb-0">@update.Message</p>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        No status updates are available yet.
    </div>
}

@if (Model.Status == "Resolved")
{
    <div class="mt-3 mb-4">
        <form asp-controller="Ticket"
              asp-action="Close"
              asp-route-id="@Model.Id"
              method="post"
              class="d-inline">

            <button type="submit"
                    class="btn btn-success"
                    onclick="return confirm('Are you satisfied with the resolution?');">
                Close Ticket
            </button>
        </form>

        <form asp-controller="Ticket"
              asp-action="Reopen"
              asp-route-id="@Model.Id"
              method="post"
              class="mt-3">

            <label for="reason" class="form-label">
                Reason for reopening
            </label>

            <textarea id="reason"
                      name="reason"
                      class="form-control"
                      rows="3"
                      minlength="3"
                      maxlength="2000"
                      required
                      placeholder="Explain why the issue is not resolved..."></textarea>

            <button type="submit"
                    class="btn btn-warning mt-2">
                Reopen Ticket
            </button>
        </form>
    </div>
}

<a asp-action="MyTickets" class="btn btn-secondary">
    Back to My Tickets
</a>