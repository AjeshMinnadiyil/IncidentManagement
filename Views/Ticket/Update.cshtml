
@model IncidentManagement.ViewModels.TicketUpdateViewModel

@{
    ViewData["Title"] = "Update Ticket";
}

<h2>Update Ticket</h2>

<form asp-action="Update" method="post">
    @Html.AntiForgeryToken()

    <input asp-for="TicketId" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>

        <select asp-for="Status" class="form-select">
            <option value="In Progress">In Progress</option>
            <option value="Resolved">Resolved</option>
        </select>


        <span asp-validation-for="Status"
              class="text-danger"></span>
    </div>
    @if (ViewBag.ReopenReason != null)
    {
        <div class="alert alert-warning mb-3">
            <h5>Employee Reopen Reason</h5>
            <p class="mb-0">@ViewBag.ReopenReason</p>
        </div>
    }

    <div class="mb-3">
        <label asp-for="Message" class="form-label">
            Update / Resolution Notes
        </label>

        <textarea asp-for="Message"
                  class="form-control"
                  rows="4"></textarea>

        <span asp-validation-for="Message"
              class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsVisibleToUser"
               class="form-check-input" />

        <label asp-for="IsVisibleToUser"
               class="form-check-label">
            Visible to employee
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Update
    </button>

    <a asp-controller="Technician"
       asp-action="Index"
       class="btn btn-secondary ms-2">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
